  "description": "Previsão de surfe do Sul ao Nordeste do Brasil: uma nota de 0 a 10 por pico e por horário, ajustada ao nível do surfista.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafinhatsantos/vale-o-pico.git"
  },
  "homepage": "https://surf-view.vercel.app",
  "keywords": [
    "surf",
    "previsao",
    "nextjs",
    "typescript",
    "open-meteo"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "predev": "node scripts/copy-maplibre.mjs",
    "prebuild": "node scripts/copy-maplibre.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
